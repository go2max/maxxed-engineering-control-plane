{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techmaxxed.com/schemas/engineering-planning-manifest-v1.json",
  "title": "Maxxed Engineering Planning Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planVersion", "target", "budgetPolicy", "milestones"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "planVersion": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sustainedLeverageTarget", "architectureCeilingDesign"],
      "properties": {
        "sustainedLeverageTarget": {"type": "number", "minimum": 1},
        "architectureCeilingDesign": {"type": "number", "minimum": 1}
      }
    },
    "budgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubHostedComputeUsd", "neonMonthlyTargetUsd", "flyIoEngineeringScaling", "cloudflareScalingPolicy"],
      "properties": {
        "githubHostedComputeUsd": {"type": "number", "minimum": 0},
        "neonMonthlyTargetUsd": {"type": "number", "minimum": 0},
        "flyIoEngineeringScaling": {"enum": ["excluded", "included"]},
        "cloudflareScalingPolicy": {"enum": ["flat-until-evidence", "elastic"]}
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "priority", "statusIntent", "acceptance", "dependencies", "adminIssues"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "statusIntent": {"enum": ["planned", "active", "blocked", "accepted", "superseded"]},
          "targetLeverageStage": {"type": ["number", "null"], "minimum": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "adminIssues": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
          "sourceDocs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
