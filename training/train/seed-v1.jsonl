{"id":"train-scheduler-001","task_class":"task-ranking","source_category":"portfolio-scheduler","instruction":"Rank executable tasks for dispatch.","input":{"tasks":[{"id":"A","priority":80,"critical_path_depth":4,"dependency_unlocks":5,"age_minutes":20},{"id":"B","priority":95,"critical_path_depth":1,"dependency_unlocks":0,"age_minutes":3}],"repository_lane_caps":{"repo-a":2,"repo-b":2}},"output":{"preferred_order":["A","B"],"reason":"A has stronger critical-path and dependency-unlock value despite lower nominal priority"},"provenance":{"source":"validated-platform-behavior","category":"portfolio-scheduler"},"tags":["critical-path","priority","dependency-unlock"]}
