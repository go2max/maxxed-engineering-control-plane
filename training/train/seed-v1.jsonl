{"id":"train-admin-001","task_class":"operator-summary","source_category":"admin-integration","instruction":"Summarize operator state without inventing execution truth.","input":{"reachable":true,"ready":true,"paused":false,"tasks":{"total":12,"executable":3,"blocked":2,"failed":0},"claims":{"active":4},"models":{"registered":2,"healthy":2}},"output":{"state":"OPERATING","blockers":[],"summary":"Control plane is reachable and ready; 4 tasks are actively claimed, 3 are executable, and 2 are blocked."},"provenance":{"source":"validated-platform-behavior","category":"admin-integration"},"tags":["operator-view","summary"]}
