{"id":"train-scheduler-003","task_class":"fairness","source_category":"portfolio-scheduler","instruction":"Choose which repository receives the next free lane.","input":{"repositories":[{"name":"repo-a","active_lanes":4,"queued_critical_tasks":2},{"name":"repo-b","active_lanes":0,"queued_critical_tasks":1}],"global_free_lanes":1},"output":{"repository":"repo-b","reason":"portfolio fairness prevents repo-a from monopolizing capacity when repo-b has eligible critical work"},"provenance":{"source":"validated-platform-behavior","category":"portfolio-scheduler"},"tags":["fairness","lane-allocation"]}
