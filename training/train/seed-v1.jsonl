{"id":"train-liveness-001","task_class":"failure-classification","source_category":"compute-fabric","instruction":"Classify the worker condition and recommend the scheduler action.","input":{"heartbeat_age_seconds":16,"degraded_after_seconds":10,"offline_after_seconds":15,"active_task_restartable":true},"output":{"classification":"worker-offline","scheduler_action":"fence-current-lease-and-requeue","reason":"heartbeat age exceeds offline threshold; restartable work may be reassigned after fencing"},"provenance":{"source":"validated-platform-behavior","category":"compute-fabric"},"tags":["liveness","failover","fencing"]}
